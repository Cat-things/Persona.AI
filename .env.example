# Copy to .env for development. The installer generates its own .env with real secrets.
SECRET_KEY=change-me-to-a-long-random-string
ENVIRONMENT=development
PUBLIC_URL=http://localhost:8000
DATA_DIR=./data

# LLM: any OpenAI-compatible server (Ollama shown), or LLM_PROVIDER=mock for no model at all
LLM_PROVIDER=openai
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=
LLM_MODEL=llama3.1:8b
LLM_CONTEXT_TOKENS=8192

# Optional providers (see docs/providers.md)
IMAGE_PROVIDER=
TTS_PROVIDER=none
STT_PROVIDER=none
